<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScanIngest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.*" />
    <PackageReference Include="Dapper" Version="2.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project sits at the repository root, so its default source glob
         would otherwise sweep up the test project's files as well. -->
    <Compile Remove="ScanIngest.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- queries.sql is the single source of the report SQL, read at runtime by
         SqlLibrary. Copy it next to the binary so it is found the same way
         whether run via `dotnet run` or from a published folder. -->
    <None Update="queries.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
